{
  "name": "zod-bridge",
  "version": "0.1.0",
  "description": "The missing async validation layer for Zod. Typed Prisma errors + DB-aware unique validators.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prisma": {
      "types": "./dist/adapters/prisma/index.d.ts",
      "import": "./dist/adapters/prisma/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:push": "prisma db push"
  },
  "keywords": [
    "zod",
    "prisma",
    "validation",
    "typescript",
    "async"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luis-serrano-l/zod-bridge.git"
  },
  "homepage": "https://github.com/luis-serrano-l/zod-bridge#readme",
  "bugs": {
    "url": "https://github.com/luis-serrano-l/zod-bridge/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "peerDependencies": {
    "@prisma/client": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "testcontainers": "^11.14.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "sideEffects": false
}
