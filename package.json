{
  "name": "zod-bridge",
  "version": "0.0.1",
  "description": "The missing async validation layer for Zod. Typed Prisma errors + DB-aware unique validators.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./prisma": {
      "import": "./dist/adapters/prisma/index.js",
      "types": "./dist/adapters/prisma/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["zod", "prisma", "validation", "typescript", "async"],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "zod": "^4.0.0",
    "@prisma/client": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": { "optional": true }
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "@types/node": "^25.6.2",
    "prisma": "^7.8.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "zod": "^4.4.3"
  }
}
