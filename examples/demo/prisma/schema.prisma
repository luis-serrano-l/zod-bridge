generator client {
  provider = "prisma-client-js"
}

// Writes prisma/generated/zod-bridge.ts: one descriptor per model, read by createSchema().
generator zodBridge {
  provider = "zod-bridge"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  posts Post[]
}

model Post {
  id       Int  @id @default(autoincrement())
  authorId Int
  author   User @relation(fields: [authorId], references: [id])
}

model Like {
  userId Int
  postId Int

  @@unique([userId, postId])
}
